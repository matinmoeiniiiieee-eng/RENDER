# Copy to .env for local development. On Deplexo/Render/Railway set these as
# environment variables in the dashboard instead.

# Panel login password. ALWAYS set this to something strong (min 8 chars).
# Leaving it unset boots with the temporary password "admin" and the panel
# forces a change on first login. Changing this value later now takes effect
# on the next restart (it used to be ignored once state had been saved).
ADMIN_PASSWORD=change-me-to-something-strong

# Where ren_data.json lives. Point DATA_DIR at a mounted volume
# (/data on Deplexo and Railway, /var/data on Render) so links survive redeploys.
# The Docker image (used by Deplexo) already defaults DATA_DIR to /data.
# DATA_DIR=/data
# DATA_FILE=data/ren_data.json

# Public hostname used in vless:// links and subscriptions.
# Render/Railway inject their own variable, Deplexo does not: either set this
# (e.g. my-app.de.deplexo.com or your custom domain) or just open /login once
# through the public URL and it is auto-detected and remembered.
# PUBLIC_DOMAIN=my-app.de.deplexo.com

# Allow the tunnel to reach private/loopback/metadata IPs. Keep false.
ALLOW_PRIVATE_RANGES=false

# Local listen port. Deplexo sets PORT from run.port in deplexo.yaml (8000);
# Render/Railway inject their own PORT.
PORT=8000

# Brute-force protection for the login form.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Path prefix for XHTTP share links (/<prefix>/<uuid>). Rarely needs changing.
# REN_XHTTP_PREFIX=xhttp

# uTLS fingerprint advertised in share links.
# REN_FINGERPRINT=chrome

# ---- Network tuning (defaults are right for Deplexo/Render/Railway) ----------
# UDP over VLESS (remote DNS on :53, QUIC/HTTP3 on :443 for YouTube/Google).
# REN_UDP=true
# IPv6 egress: auto (probe for a global IPv6 route), on, off. PaaS containers
# usually have no working IPv6; auto keeps dual-stack sites on IPv4.
# REN_IPV6=auto
# REN_PREFER_IPV6=false
# Tear a tunnel down only after this many seconds with NO traffic either way.
# REN_IDLE_TIMEOUT=300
# REN_UDP_IDLE_TIMEOUT=90
# Upstream connect timeout (seconds) and resolver cache / thread pool.
# REN_CONNECT_TIMEOUT=10
# REN_DNS_CACHE_TTL=120
# REN_DNS_WORKERS=32
# WebSocket ping interval (seconds, 0 = off) so the edge never drops idle tunnels.
# REN_WS_PING_INTERVAL=20
# Fixed upstream socket buffer in bytes; 0 = Linux autotuning (fastest).
# REN_SOCKET_BUFFER=0
# Use uvloop when installed.
# REN_UVLOOP=true
