# Copy to .env for local development. On Render/Railway set these as
# environment variables in the dashboard instead.

# Panel login password. ALWAYS set this to something strong (min 8 chars).
# Leaving it unset boots with the temporary password "admin" and the panel
# forces a change on first login. Changing this value later now takes effect
# on the next restart (it used to be ignored once state had been saved).
ADMIN_PASSWORD=change-me-to-something-strong

# Where ren_data.json lives. Point DATA_DIR at a mounted volume
# (/var/data on Render, /data on Railway) so links survive redeploys.
# DATA_DIR=/data
# DATA_FILE=data/ren_data.json

# Allow the tunnel to reach private/loopback/metadata IPs. Keep false.
ALLOW_PRIVATE_RANGES=false

# Local listen port (Render/Railway inject their own PORT).
PORT=8000

# Brute-force protection for the login form.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Path prefix for XHTTP share links (/<prefix>/<uuid>). Rarely needs changing.
# REN_XHTTP_PREFIX=xhttp

# uTLS fingerprint advertised in share links.
# REN_FINGERPRINT=chrome
